# Строка подключения к PostgreSQL.
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/suggestions_db?schema=public

# Строка подключения к Redis.
# Формат: redis://HOST:PORT
REDIS_URL=redis://localhost:6379

# Порт, на котором запускается приложение NestJS
PORT=4000

# Discord Bot (для ShardingManager и Necord)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Guild ID для dev-режима (команды регистрируются только на этом сервере, обновление мгновенное)
DISCORD_DEVELOPMENT_GUILD_ID=
# ID канала для публикации предложений (из ссылки discord.com/channels/GUILD_ID/CHANNEL_ID)
DISCORD_DEVELOPMENT_CHANNEL_ID=
# После npx prisma db seed для публикации в этот канал используйте в запросах X-Company-Id: 00000000-0000-0000-0000-000000000001
